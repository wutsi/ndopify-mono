<mjml>
    <mj-head>
        <mj-style>
            {{__css__}}
        </mj-style>
    </mj-head>
    <mj-body css-class="body">
        <mj-section css-class="main-content">
            <mj-column>
                <!-- Logo -->
                <mj-image align="center" src="{{tenant_logo_url}}" alt="Logo" width="128" />

                <!-- Divider with class for CSS injection -->
                <mj-divider css-class="divider"/>

                <!-- Body Text -->
                <mj-text>
                    Bonjour <strong>{{recipient_name}}</strong>,
                </mj-text>
                <mj-text>
                    Nous vous remercions d'avoir soumis vos documents pour la vérification KYC sur {{tenant_name}}.
                </mj-text>
                <mj-text>
                    Malheureusement, nous n'avons pas pu valider votre dossier en raison d'une non-conformité ou d'une
                    illisibilité des documents fournis.
                </mj-text>
                <mj-text>
                    Pour régulariser votre situation, veuillez vous connecter à votre compte et soumettre à nouveau des
                    pièces justificatives claires et valides.
                </mj-text>

                <!-- Button with class for CSS injection -->
                <mj-spacer/>
                <mj-button href="{{kyc_url}}" css-class="btn-primary" align="center">
                    Re-soumettre vos documents
                </mj-button>
                <mj-spacer/>

                <!-- Sign-off -->
                <mj-spacer/>
                <mj-text>
                    Cordialement,
                    <br/>
                    L'équipe {{tenant_name}}
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
