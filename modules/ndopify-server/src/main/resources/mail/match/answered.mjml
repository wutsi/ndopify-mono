<mjml>
    <mj-head>
        <mj-style inline="inline">
            {{__css__}}
        </mj-style>
    </mj-head>
    <mj-body css-class="body">
        <mj-section css-class="main-content">
            <mj-column>
                <!-- Logo -->
                <mj-image align="center" src="{{tenant_logo_url}}" alt="Logo" width="128" />

                <!-- Divider with class for CSS injection -->
                <mj-divider css-class="divider"/>

                <!-- Body Text -->
                <mj-text>
                    Bonjour <strong>{{recipient_name}}</strong>,
                </mj-text>
                <mj-text>{{#accepted}}Bonne nouvelle&#160;: <strong>{{customer_name}}</strong> a accepté la
                    proposition.{{/accepted}}{{^accepted}}<strong>{{customer_name}}</strong> a refusé la
                    proposition.{{/accepted}}</mj-text>
                {{#rejection_reason}}
                <mj-text>
                    Motif&#160;: {{rejection_reason}}
                </mj-text>
                {{/rejection_reason}}
                {{#comment}}
                <mj-text>
                    «&#160;{{comment}}&#160;»
                </mj-text>
                {{/comment}}

                <!-- In an mj-text: MJML drops raw HTML outside of it -->
                <mj-text>
                    <ul>
                        <li>
                            <b>Bien</b>: {{listing_title}}
                        </li>
                        <li>
                            <b>{{price_label}}</b>: {{price}}
                        </li>
                        <li>
                            <b>Recherche</b>: {{listing_type}}{{#property_type}} - {{property_type}}{{/property_type}}
                        </li>
                        <li>
                            <b>Ville</b>: {{city}}
                        </li>
                        {{#neighbourhoods}}
                        <li>
                            <b>Quartier(s)</b>: {{neighbourhoods}}
                        </li>
                        {{/neighbourhoods}}
                        <li>
                            <b>Budget</b>: {{budget}}
                        </li>
                    </ul>
                </mj-text>

                <mj-text>
                    Cette réponse est définitive. Retrouvez le mandat pour la suite.
                </mj-text>

                {{#mandate_url}}
                <!-- Button with class for CSS injection -->
                <mj-spacer/>
                <mj-button href="{{mandate_url}}" css-class="btn-primary" align="center">
                    Voir le mandat
                </mj-button>
                <mj-spacer/>
                {{/mandate_url}}

                <!-- Sign-off -->
                <mj-spacer/>
                <mj-text>
                    Cordialement,
                    <br/>
                    L'équipe {{tenant_name}}
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
