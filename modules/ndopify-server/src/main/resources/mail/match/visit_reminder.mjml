<mjml>
    <mj-head>
        <mj-style inline="inline">
            {{__css__}}
        </mj-style>
    </mj-head>
    <mj-body css-class="body">
        <mj-wrapper background-color="#ffffff" border-radius="30px" padding="20px">
            <mj-section padding="0">
                <mj-column>
                    <!-- Logo -->
                    <mj-image align="center" src="{{tenant_logo_url}}" alt="Logo" width="128" />

                    <!-- Divider with class for CSS injection -->
                    <mj-divider css-class="divider"/>

                    <!-- Body Text -->
                    <mj-text>
                        Bonjour <strong>{{recipient_name}}</strong>,
                    </mj-text>
                    <mj-text>
                        Vous avez indiqué que ce bien vous intéresse. Si vous souhaitez le visiter, choisissez un
                        créneau qui vous convient&#160;: votre demande ne prend que quelques secondes.
                    </mj-text>

                    <!-- The listing's cover, linked to its page when there is one -->
                    {{#image_url}}
                    <mj-image src="{{image_url}}" alt="{{listing_title}}" {{#listing_url}}href="{{listing_url}}"{{/listing_url}}
                              border-radius="8px" padding="10px 0"/>
                    {{/image_url}}
                    <!-- In an mj-text: MJML drops raw HTML outside of it -->
                    <mj-text>
                        <ul>
                            <li>
                                <b>{{listing_title}}</b>
                            </li>
                            <li>
                                <b>{{price_label}}</b>&#160;: {{price}}
                            </li>
                        </ul>
                    </mj-text>

                    <!-- Button with class for CSS injection. The match's page: the visit form waits there -->
                    {{#listing_url}}
                    <mj-button href="{{listing_url}}" css-class="btn-primary" align="center">
                        Demander une visite
                    </mj-button>
                    <mj-spacer/>
                    {{/listing_url}}

                    {{#online}}
                    <mj-text>
                        Choisissez votre créneau sur la page du bien.
                    </mj-text>
                    {{/online}}
                    {{^online}}
                    <mj-text>
                        Répondez-moi et je vous proposerai un créneau.
                    </mj-text>
                    {{/online}}

                    <!-- Sign-off -->
                    <mj-spacer/>
                    <mj-text>
                        Cordialement,{{^agent_full_name}}
                        <br/>
                        L'équipe {{tenant_name}}{{/agent_full_name}}
                    </mj-text>
                </mj-column>
            </mj-section>
            {{> mail/fragments/agent-footer.mjml}}
        </mj-wrapper>
    </mj-body>
</mjml>
