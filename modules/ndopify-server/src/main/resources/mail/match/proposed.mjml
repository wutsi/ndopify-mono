<mjml>
    <mj-head>
        <mj-style inline="inline">
            {{__css__}}
        </mj-style>
    </mj-head>
    <mj-body css-class="body">
        <mj-section css-class="main-content">
            <mj-column>
                <!-- Logo -->
                <mj-image align="center" src="{{tenant_logo_url}}" alt="Logo" width="128" />

                <!-- Divider with class for CSS injection -->
                <mj-divider css-class="divider"/>

                <!-- Body Text -->
                <mj-text>
                    Bonjour <strong>{{recipient_name}}</strong>,
                </mj-text>
                <mj-text>
                    <strong>{{agent_full_name}}</strong>, votre agent, a sélectionné pour vous un bien qui correspond
                    à votre recherche&#160;:
                </mj-text>

                <!-- In an mj-text: MJML drops raw HTML outside of it -->
                <mj-text>
                    <ul>
                        <li>
                            <b>{{listing_title}}</b>
                        </li>
                        <li>
                            <b>{{price_label}}</b>&#160;: {{price}}
                        </li>
                    </ul>
                </mj-text>

                <!-- With the match's page: the customer answers there. Without it: by replying to the agent. -->
                {{#listing_url}}
                <mj-text>
                    Découvrez ses photos et tous ses détails, puis dites-nous s'il vous intéresse. Si c'est le cas,
                    vous pourrez demander une visite dans la foulée.
                </mj-text>

                <!-- Button with class for CSS injection -->
                <mj-spacer/>
                <mj-button href="{{listing_url}}" css-class="btn-primary" align="center">
                    Voir le bien et répondre
                </mj-button>
                <mj-spacer/>

                <mj-text>
                    Il ne vous convient pas&#160;? Dites-le aussi&#160;: votre agent en tiendra compte pour ses
                    prochaines propositions.
                </mj-text>
                {{/listing_url}}
                {{^listing_url}}
                <mj-text>
                    Ce bien vous intéresse&#160;? Répondez à votre agent&#160;: il organisera la visite avec vous.
                    S'il ne vous convient pas, dites-le-lui aussi, il en tiendra compte pour ses prochaines
                    propositions.
                </mj-text>
                {{/listing_url}}

                <!-- Sign-off -->
                <mj-spacer/>
                <mj-text>
                    Cordialement,
                    <br/>
                    L'équipe {{tenant_name}}
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
