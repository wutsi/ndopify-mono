<mjml>
    <mj-head>
        <mj-style inline="inline">
            {{__css__}}
        </mj-style>
    </mj-head>
    <mj-body css-class="body">
        <mj-section css-class="main-content">
            <mj-column>
                <!-- Logo -->
                <mj-image align="center" src="{{tenant_logo_url}}" alt="Logo" width="128" />

                <!-- Divider with class for CSS injection -->
                <mj-divider css-class="divider"/>

                <!-- Body Text -->
                <mj-text>
                    Bonjour <strong>{{recipient_name}}</strong>,
                </mj-text>
                <mj-text>
                    Pour recevoir vos notifications sur Telegram, ouvrez le bot Ndopify et envoyez-lui ce code :
                </mj-text>
                <mj-text font-weight="bold" font-size="20px">
                    {{telegram_code}}
                </mj-text>
                <mj-text>
                    Il expire dans {{ttl}} minutes. Si vous n'êtes pas à l'origine de cette demande, ignorez cet
                    e-mail.
                </mj-text>
                <mj-button href="{{bot_url}}">Ouvrir Telegram</mj-button>

                <!-- Sign-off -->
                <mj-spacer/>
                <mj-text>
                    Cordialement,
                    <br/>
                    L'équipe {{tenant_name}}
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
