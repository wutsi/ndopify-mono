<mjml>
    <mj-head>
        {{> mail/fragments/styles.mjml}}
        <mj-preview>Votre mandat à {{place}}</mj-preview>
    </mj-head>
    <mj-body css-class="body">
        <mj-wrapper background-color="#ffffff" border-radius="30px" padding="20px">
            <mj-section padding="0">
                <mj-column>
                    <!-- Divider with class for CSS injection: the card's only brand mark -->
                    <mj-divider css-class="divider"/>

                    <!-- Body Text -->
                    <mj-text>
                        Bonjour <strong>{{recipient_name}}</strong>,
                    </mj-text>
                    <mj-text>
                        {{^sale}}Je prends en charge la mise en location de votre bien.{{/sale}}{{#sale}}Je prends en
                        charge la vente de votre bien.{{/sale}} Je serai votre interlocuteur pour ce mandat.
                    </mj-text>
                    <mj-text>
                        Je me présente&#160;:
                    </mj-text>
                    <mj-text font-weight="bold" font-size="18px">
                        {{agent_full_name}}
                    </mj-text>
                    {{#agent_presentation}}
                    <mj-text>
                        {{agent_presentation}}
                    </mj-text>
                    {{/agent_presentation}}
                    <mj-text font-weight="bold" font-size="18px">
                        Prochaine étape&#160;:
                    </mj-text>
                    <mj-text font-weight="bold">
                        Je vous contacterai très prochainement par téléphone afin de faire le point, d'organiser une
                        visite de votre bien et de répondre à vos premières questions.
                    </mj-text>

                    {{> mail/fragments/whatsapp-reply.mjml}}

                    <!-- Sign-off -->
                    <mj-text>
                        Cordialement,
                    </mj-text>
                </mj-column>
            </mj-section>
            {{> mail/fragments/agent-footer.mjml}}
        </mj-wrapper>
    </mj-body>
</mjml>
