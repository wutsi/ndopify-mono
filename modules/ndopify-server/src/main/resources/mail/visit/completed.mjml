<mjml>
    <mj-head>
        {{> mail/fragments/styles.mjml}}
        <mj-preview>{{visit_date}} · {{listing_title}}</mj-preview>
    </mj-head>
    <mj-body css-class="body">
        <mj-wrapper background-color="#ffffff" border-radius="30px" padding="20px">
            <mj-section padding="0">
                <mj-column>
                    <!-- Divider with class for CSS injection: the card's only brand mark -->
                    <mj-divider css-class="divider"/>

                    <!-- The listing's photo, if any, linked to the visit's page when there is one -->
                    {{#image_url}}
                    <mj-image src="{{image_url}}" alt="{{listing_title}}" {{#visit_url}}href="{{visit_url}}"{{/visit_url}}
                              border-radius="8px" padding="10px 0"/>
                    {{/image_url}}

                    <!-- Body Text -->
                    <mj-text>
                        Bonjour <strong>{{recipient_name}}</strong>,
                    </mj-text>
                    <mj-text>
                        Notre visite du bien <strong>{{listing_title}}</strong> du {{visit_date}} à {{visit_time}} est
                        terminée.
                    </mj-text>
                    <mj-text font-weight="bold" font-size="18px">
                        Alors, ce bien vous intéresse&#160;?
                    </mj-text>
                    <mj-text>
                        Dites-le-moi&#160;: je vous accompagnerai pour la suite. Sinon, dites-le-moi aussi, j'en
                        tiendrai compte pour mes prochaines propositions.
                    </mj-text>

                    {{#visit_url}}
                    <mj-button href="{{visit_url}}" css-class="btn-primary nd-btn" align="center">
                        Donner mon avis
                    </mj-button>
                    {{/visit_url}}

                    {{> mail/fragments/whatsapp-reply.mjml}}

                    <!-- Sign-off -->
                    <mj-text>
                        Cordialement,
                    </mj-text>
                </mj-column>
            </mj-section>
            {{> mail/fragments/agent-footer.mjml}}
        </mj-wrapper>
    </mj-body>
</mjml>
