<mjml>
    <mj-head>
        <mj-style inline="inline">
            {{__css__}}
        </mj-style>
    </mj-head>
    <mj-body css-class="body">
        <mj-wrapper background-color="#ffffff" border-radius="30px" padding="20px">
            <mj-section padding="0">
                <mj-column>
                    <!-- Logo -->
                    <mj-image align="center" src="{{tenant_logo_url}}" alt="Logo" width="128" />

                    <!-- Divider with class for CSS injection -->
                    <mj-divider css-class="divider"/>

                    <!-- The listing's photo, if any, linked to the visit's page when there is one -->
                    {{#image_url}}
                    <mj-image src="{{image_url}}" alt="{{listing_title}}" {{#visit_url}}href="{{visit_url}}"{{/visit_url}}
                              border-radius="8px" padding="10px 0"/>
                    {{/image_url}}

                    <!-- Body Text -->
                    <mj-text>
                        Bonjour <strong>{{recipient_name}}</strong>,
                    </mj-text>
                    <mj-text>
                        Votre visite du bien <strong>{{listing_title}}</strong> du {{visit_date}} à {{visit_time}} est
                        terminée.
                    </mj-text>
                    <mj-text font-weight="bold" font-size="18px">
                        Le bien vous intéresse&#160;?
                    </mj-text>
                    <mj-text>
                        Dites-le à votre agent&#160;: il vous accompagnera pour la suite. Sinon, dites-le-lui aussi, il en
                        tiendra compte pour ses prochaines propositions.
                    </mj-text>

                    {{#visit_url}}
                    <mj-button href="{{visit_url}}" css-class="btn-primary" align="center">
                        Donner mon avis
                    </mj-button>
                    {{/visit_url}}

                    <!-- Sign-off -->
                    <mj-spacer/>
                    <mj-text>
                        Cordialement,
                        <br/>
                        L'équipe {{tenant_name}}
                    </mj-text>
                </mj-column>
            </mj-section>
            {{> mail/fragments/agent-footer.mjml}}
        </mj-wrapper>
    </mj-body>
</mjml>
