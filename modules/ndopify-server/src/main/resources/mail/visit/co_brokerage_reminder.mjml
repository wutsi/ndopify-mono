<mjml>
    <mj-head>
        <mj-style inline="inline">
            {{__css__}}
        </mj-style>
    </mj-head>
    <mj-body css-class="body">
        <mj-wrapper background-color="#ffffff" border-radius="30px" padding="20px">
            <mj-section padding="0">
                <mj-column>
                    <!-- Logo -->
                    <mj-image align="center" src="{{tenant_logo_url}}" alt="Logo" width="128" />

                    <!-- Divider with class for CSS injection -->
                    <mj-divider css-class="divider"/>

                    <!-- The listing's photo, if any, linked to the listing's page when there is one -->
                    {{#image_url}}
                    <mj-image src="{{image_url}}" alt="{{listing_title}}" {{#listing_url}}href="{{listing_url}}"{{/listing_url}}
                              border-radius="8px" padding="10px 0"/>
                    {{/image_url}}

                    <!-- Body Text -->
                    <mj-text>
                        Bonjour <strong>{{recipient_name}}</strong>,
                    </mj-text>
                    <mj-text>
                        Rappel&#160;: la visite de votre bien <strong>{{listing_title}}</strong> a lieu le
                        <strong>{{visit_date}} à {{visit_time}}</strong> ({{type_label}}).
                    </mj-text>
                    {{#on_site}}
                    <mj-text>
                        Je vous y retrouve avec mon client.
                    </mj-text>
                    {{/on_site}}
                    {{^on_site}}
                    <mj-text>
                        Je serai sur place pour vous ouvrir&#160;; le client suivra en visio.
                    </mj-text>
                    {{/on_site}}
                    <mj-text>
                        Visite organisée par <strong>{{agent_full_name}}</strong>{{#agent_profile_url}} —
                        <a href="{{agent_profile_url}}">voir le profil</a>{{/agent_profile_url}}.
                    </mj-text>

                    {{#listing_url}}
                    <mj-button href="{{listing_url}}" css-class="btn-primary" align="center">
                        Voir l'annonce
                    </mj-button>
                    {{/listing_url}}

                    <!-- Sign-off -->
                    <mj-spacer/>
                    <mj-text>
                        Cordialement,{{^agent_full_name}}
                        <br/>
                        L'équipe {{tenant_name}}{{/agent_full_name}}
                    </mj-text>
                </mj-column>
            </mj-section>
            {{> mail/fragments/agent-footer.mjml}}
        </mj-wrapper>
    </mj-body>
</mjml>
