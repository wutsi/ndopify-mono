<mjml>
    <mj-head>
        <mj-style inline="inline">
            {{__css__}}
        </mj-style>
    </mj-head>
    <mj-body css-class="body">
        <mj-wrapper background-color="#ffffff" border-radius="30px" padding="20px">
            <mj-section padding="0">
                <mj-column>
                    <!-- Logo -->
                    <mj-image align="center" src="{{tenant_logo_url}}" alt="Logo" width="128" />

                    <!-- Divider with class for CSS injection -->
                    <mj-divider css-class="divider"/>

                    <!-- The listing's photo, if any, linked to the visit's page when there is one -->
                    {{#image_url}}
                    <mj-image src="{{image_url}}" alt="{{listing_title}}" {{#visit_url}}href="{{visit_url}}"{{/visit_url}}
                              border-radius="8px" padding="10px 0"/>
                    {{/image_url}}

                    <!-- Body Text -->
                    <mj-text>
                        Bonjour <strong>{{recipient_name}}</strong>,
                    </mj-text>
                    <mj-text>
                        Votre visite du bien <strong>{{listing_title}}</strong> est confirmée le
                        <strong>{{visit_date}} à {{visit_time}}</strong>.
                    </mj-text>
                    {{#place}}
                    <mj-text>
                        Localisation&#160;: <strong>{{place}}</strong>{{#landmark}} — {{landmark}}{{/landmark}}
                    </mj-text>
                    {{/place}}

                    {{#on_site}}
                    <mj-text>
                        Je vous attends sur place. Vous pouvez me joindre sur WhatsApp au
                        <strong>{{agent_whatsapp}}</strong>.
                    </mj-text>
                    <mj-text>
                        Votre code de visite est <strong>{{code}}</strong>. Présentez-le-moi à votre arrivée.
                    </mj-text>
                    <mj-text>
                        Je vous communiquerai l'adresse exacte et l'itinéraire avant la visite.
                    </mj-text>
                    {{/on_site}}
                    {{^on_site}}
                    <mj-text>
                        Je vous appellerai en vidéo sur WhatsApp au <strong>{{agent_whatsapp}}</strong> depuis le bien,
                        à l'heure convenue.
                    </mj-text>
                    <mj-text>
                        Votre code de visite est <strong>{{code}}</strong>. Lisez-le-moi pendant l'appel.
                    </mj-text>
                    {{/on_site}}

                    {{#visit_url}}
                    <mj-button href="{{visit_url}}" css-class="btn-primary" align="center">
                        Voir ma visite
                    </mj-button>
                    {{/visit_url}}

                    <!-- Sign-off -->
                    <mj-spacer/>
                    <mj-text>
                        Cordialement,{{^agent_full_name}}
                        <br/>
                        L'équipe {{tenant_name}}{{/agent_full_name}}
                    </mj-text>
                </mj-column>
            </mj-section>
            {{> mail/fragments/agent-footer.mjml}}
        </mj-wrapper>
    </mj-body>
</mjml>
