<mjml>
    <mj-head>
        {{> mail/fragments/styles.mjml}}
        <mj-preview>{{visit_date}} à {{visit_time}} · {{listing_title}}</mj-preview>
    </mj-head>
    <mj-body css-class="body">
        <mj-wrapper background-color="#ffffff" border-radius="30px" padding="20px">
            <mj-section padding="0">
                <mj-column>
                    <!-- Divider with class for CSS injection: the card's only brand mark -->
                    <mj-divider css-class="divider"/>

                    <!-- The listing's photo, if any, linked to the visit's page when there is one -->
                    {{#image_url}}
                    <mj-image src="{{image_url}}" alt="{{listing_title}}" {{#visit_url}}href="{{visit_url}}"{{/visit_url}}
                              border-radius="8px" padding="10px 0"/>
                    {{/image_url}}

                    <!-- Body Text -->
                    <mj-text>
                        Bonjour <strong>{{recipient_name}}</strong>,
                    </mj-text>
                    {{#by_agent}}
                    <mj-text>
                        Je vous confirme la visite que j'ai organisée&#160;: <strong>{{listing_title}}</strong>,
                        <strong>{{visit_date}} à {{visit_time}}</strong>.
                    </mj-text>
                    {{/by_agent}}
                    {{^by_agent}}
                    <mj-text>
                        Je vous confirme notre visite&#160;: <strong>{{listing_title}}</strong>,
                        <strong>{{visit_date}} à {{visit_time}}</strong>.
                    </mj-text>
                    {{/by_agent}}
                    {{#place}}
                    <mj-text>
                        Localisation&#160;: <strong>{{place}}</strong>{{#landmark}} — {{landmark}}{{/landmark}}
                    </mj-text>
                    {{/place}}

                    {{#on_site}}
                    <mj-text>
                        Je vous attends sur place. Votre code de visite est <strong>{{code}}</strong>&#160;:
                        présentez-le-moi à votre arrivée.
                    </mj-text>
                    <mj-text>
                        Je vous communiquerai l'adresse exacte et l'itinéraire avant la visite.
                    </mj-text>
                    {{/on_site}}
                    {{^on_site}}
                    <mj-text>
                        Je vous appellerai en vidéo sur WhatsApp depuis le bien, à l'heure convenue.
                    </mj-text>
                    <mj-text>
                        Votre code de visite est <strong>{{code}}</strong>&#160;: lisez-le-moi pendant l'appel.
                    </mj-text>
                    {{/on_site}}

                    {{#by_agent}}
                    <mj-text>
                        Vous pouvez annuler la visite à tout moment depuis votre page de visite.
                    </mj-text>
                    {{/by_agent}}

                    {{#visit_url}}
                    <mj-button href="{{visit_url}}" css-class="btn-primary nd-btn" align="center">
                        Voir ma visite
                    </mj-button>
                    {{/visit_url}}

                    {{> mail/fragments/whatsapp-reply.mjml}}

                    <!-- Sign-off -->
                    <mj-text>
                        Cordialement,
                    </mj-text>
                </mj-column>
            </mj-section>
            {{> mail/fragments/agent-footer.mjml}}
        </mj-wrapper>
    </mj-body>
</mjml>
