<mjml>
    <mj-head>
        {{#agent_customer_email}}
        {{> mail/fragments/styles.mjml}}
        <mj-preview>{{#visit_date}}{{visit_date}} à {{visit_time}} · {{/visit_date}}{{listing_title}}</mj-preview>
        {{/agent_customer_email}}
        {{^agent_customer_email}}
        <mj-style inline="inline">
            {{__css__}}
        </mj-style>
        {{/agent_customer_email}}
    </mj-head>
    <mj-body css-class="body">
        <mj-wrapper background-color="#ffffff" border-radius="30px" padding="20px">
            <mj-section padding="0">
                <mj-column>
                    {{^agent_customer_email}}
                    <!-- Logo: the agent copy keeps the platform layout -->
                    <mj-image align="center" src="{{tenant_logo_url}}" alt="Logo" width="128" />

                    {{/agent_customer_email}}
                    <!-- Divider with class for CSS injection: the customer copy's only brand mark -->
                    <mj-divider css-class="divider"/>

                    <!-- The listing's photo, if any, linked to the visit's page when there is one -->
                    {{#image_url}}
                    <mj-image src="{{image_url}}" alt="{{listing_title}}" {{#visit_url}}href="{{visit_url}}"{{/visit_url}}
                              border-radius="8px" padding="10px 0"/>
                    {{/image_url}}

                    <!-- Body Text -->
                    <mj-text>
                        Bonjour <strong>{{recipient_name}}</strong>,
                    </mj-text>
                    {{#agent_full_name}}
                    <mj-text>
                        Je dois annuler notre visite du bien <strong>{{listing_title}}</strong>{{#visit_date}} prévue le
                        <strong>{{visit_date}} à {{visit_time}}</strong>{{/visit_date}}.
                    </mj-text>
                    {{#cancellation_reason}}
                    <mj-text>
                        <b>Motif</b>&#160;: {{cancellation_reason}}
                    </mj-text>
                    {{/cancellation_reason}}
                    {{/agent_full_name}}
                    {{^agent_full_name}}
                    <mj-text>
                        La visite du bien <strong>{{listing_title}}</strong>
                        {{#visit_date}}prévue le {{visit_date}} à {{visit_time}}{{/visit_date}}{{^visit_date}}que vous avez
                        demandée{{/visit_date}} a été annulée.
                    </mj-text>
                    <mj-text>
                        {{cancelled_by_label}}
                    </mj-text>
                    {{#cancellation_reason}}
                    <mj-text>
                        <b>Motif</b>&#160;: {{cancellation_reason}}
                    </mj-text>
                    {{/cancellation_reason}}
                    {{^system_cancelled}}
                    <mj-text>
                        Contactez {{other_party}} pour convenir d'une autre date.
                    </mj-text>
                    {{/system_cancelled}}
                    {{/agent_full_name}}

                    {{#visit_url}}
                    {{#agent_customer_email}}
                    <mj-button href="{{visit_url}}" css-class="btn-primary nd-btn" align="center">
                        Voir la visite
                    </mj-button>
                    {{/agent_customer_email}}
                    {{^agent_customer_email}}
                    <mj-button href="{{visit_url}}" css-class="btn-primary" align="center">
                        Voir la visite
                    </mj-button>
                    {{/agent_customer_email}}
                    {{/visit_url}}

                    {{> mail/fragments/whatsapp-reply.mjml}}

                    <!-- Sign-off -->
                    {{#agent_customer_email}}
                    <mj-text>
                        Cordialement,
                    </mj-text>
                    {{/agent_customer_email}}
                    {{^agent_customer_email}}
                    <mj-spacer/>
                    <mj-text>
                        Cordialement,{{^agent_full_name}}
                        <br/>
                        L'équipe {{tenant_name}}{{/agent_full_name}}
                    </mj-text>
                    {{/agent_customer_email}}
                </mj-column>
            </mj-section>
            {{> mail/fragments/agent-footer.mjml}}
        </mj-wrapper>
    </mj-body>
</mjml>
