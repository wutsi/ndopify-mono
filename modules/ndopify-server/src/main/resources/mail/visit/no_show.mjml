<mjml>
    <mj-head>
        <mj-style inline="inline">
            {{__css__}}
        </mj-style>
    </mj-head>
    <mj-body css-class="body">
        <mj-section css-class="main-content">
            <mj-column>
                <!-- Logo -->
                <mj-image align="center" src="{{tenant_logo_url}}" alt="Logo" width="128" />

                <!-- Divider with class for CSS injection -->
                <mj-divider css-class="divider"/>

                <!-- Body Text -->
                <mj-text>
                    Bonjour <strong>{{recipient_name}}</strong>,
                </mj-text>
                <mj-text>
                    La visite du bien <strong>{{listing_title}}</strong> prévue le {{visit_date}} à {{visit_time}}
                    n'a pas eu lieu.
                </mj-text>
                <mj-text>
                    {{reason_label}}
                </mj-text>
                <mj-text>
                    Vous pouvez demander une nouvelle visite&#160;: votre agent ({{other_party}}) organisera celle qui
                    vous convient.
                </mj-text>

                {{#visit_url}}
                <mj-button href="{{visit_url}}" css-class="btn-primary" align="center">
                    Demander une autre visite
                </mj-button>
                {{/visit_url}}

                <!-- Sign-off -->
                <mj-spacer/>
                <mj-text>
                    Cordialement,
                    <br/>
                    L'équipe {{tenant_name}}
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
